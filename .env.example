# ==============================================================================
# FoodLog — Environment Configuration
# ==============================================================================

# Data Source Mode:
# 'mock'     -> Uses in-browser mock storage (persisted via localStorage)
# 'supabase' -> Connects to live Supabase PostgreSQL backend
VITE_DATA_SOURCE=mock

# Supabase Project Credentials (Required when VITE_DATA_SOURCE=supabase)
# Obtain these from your Supabase Project Settings -> API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: NEVER expose Supabase Service-Role / Secret keys in the browser!
# Only the public 'anon' key should be provided to frontend Vite clients.
